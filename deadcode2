.hl{position:absolute;left:0;width:100%;height:clamp(200px,40vh,380px);top:calc(var(--hz) - clamp(200px,40vh,380px) + 56px);will-change:transform}
.hl.far{translate:0 calc(var(--sy,0px) * -.05)}.hl.mid{translate:0 calc(var(--sy,0px) * -.12)}
