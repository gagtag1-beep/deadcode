/* PHASE 1 environment runtime: stars, parallax, fireflies. Does not touch app logic. */
(()=>{try{
const rm=matchMedia('(prefers-reduced-motion: reduce)').matches,cv=document.getElementById('stars'),x=cv.getContext('2d');let S=[],W,H;
let lw=0,lh=0;function size(){if(S.length&&lw===innerWidth&&Math.abs(lh-innerHeight)<160)return;lw=innerWidth;lh=innerHeight;const d=Math.min(devicePixelRatio||1,COARSE?1.5:2);W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;x.setTransform(d,0,0,d,0,0);
 let n=Math.min(LOW?60:150,W*H/9000|0);S=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H*.62,r:Math.random()*1.2+.3,p:Math.random()*6.28,s:.5+Math.random()*1.5}));draw(0)}
function draw(t){x.clearRect(0,0,W,H);for(const q of S){x.globalAlpha=rm?.7:.45+.45*Math.sin(t/1000*q.s+q.p);x.fillStyle=q.r>1.1?'#cfe0ff':'#fff';x.beginPath();x.arc(q.x,q.y,q.r,0,6.283);x.fill()}}
let run=!rm,lt=0;const gap=LOW?66:COARSE?33:0;(function L(t){if(run&&!document.hidden&&t-lt>=gap){lt=t;draw(t)}run&&requestAnimationFrame(L)})(0);
addEventListener('resize',size);size();
const hf=document.querySelector('.hl.far'),hm=document.querySelector('.hl.mid');let tk=0;addEventListener('scroll',()=>{if(tk||rm)return;tk=requestAnimationFrame(()=>{tk=0;const y=scrollY;hf.style.translate='0 '+(-y*.05)+'px';hm.style.translate='0 '+(-y*.12)+'px'})},{passive:true});
